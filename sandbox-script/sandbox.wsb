<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Disable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Quarantine_Zone\Staging</HostFolder>
      <SandboxFolder>C:\Sample</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Quarantine_Zone\RBI_WritableVolume\Honeypot\Desktop</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\AnalysisData</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Quarantine_Zone\RBI_WritableVolume\Honeypot\Documents</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Documents\AnalysisData</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Quarantine_Zone\RBI_WritableVolume\Honeypot\Pictures</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Pictures\AnalysisData</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Quarantine_Zone\RBI_WritableVolume\Honeypot\Downloads</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Downloads\AnalysisData</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Quarantine_Zone\RBI_WritableVolume\Telemetry</HostFolder>
      <SandboxFolder>C:\Telemetry</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\RBI_FeatureSource</HostFolder>
      <SandboxFolder>C:\FeatureSource</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\RBI_NetFx3Source</HostFolder>
      <SandboxFolder>C:\NetFx3Source</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /d /c C:\Sample\sandbox-bootstrap.cmd</Command>
  </LogonCommand>
</Configuration>
